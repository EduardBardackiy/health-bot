# Скопируй в .env и заполни. Файл .env в git не попадает (.gitignore).
BOT_TOKEN=1234567:ABC-your-telegram-bot-token

# Активный провайдер LLM: amvera (по умолчанию) или openai
LLM_PROVIDER=amvera

# Прокси для Telegram (api.telegram.org заблокирован в РФ):
# PROXY_URL=http://127.0.0.1:8080

# --- Провайдер «amvera» ---
# Токен Amvera LLM Inference — в ЛК Amvera: раздел LLM, скопировать токен
AMVERA_API_TOKEN=your-amvera-token
# Эндпоинт (по умолчанию уже в коде, можно не указывать):
# AMVERA_BASE_URL=https://inference.waw0.amvera.ru/v1
# Модель Amvera:
LLM_MODEL=glm-5.1

# --- Провайдер «openai» ---
# Ключ с platform.openai.com (там, где баланс)
OPENAI_API_KEY=sk-...
# Модель OpenAI (см. список в своём аккаунте OpenAI):
OPENAI_MODEL=gpt-5.5
